#!/bin/bash

# Log autostart execution
echo "$(date): labwc autostart running" >> /tmp/labwc-autostart.log

# Start portals for screen sharing FIRST
/home/gustavo/.nix-profile/bin/xdg-desktop-portal-wlr &
sleep 1

# Panel/bar - sfwbar (has taskbar and app menu)
sfwbar >> /tmp/sfwbar.log 2>&1 &

# Notification daemon
mako >> /tmp/mako.log 2>&1 &

# Background (if image exists)
if [ -f ~/Pictures/GLYDWAYS.JPG ]; then
    swaybg -i ~/Pictures/GLYDWAYS.JPG -m fill &
fi

# 1Password
1password &

# PolicyKit agent (use GNOME's instead)
/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 &
