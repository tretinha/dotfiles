<?xml version="1.0"?>
<labwc_config>

  <!-- Focus settings (based on openbox preferences) -->
  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <!-- Theme -->
  <theme>
    <name>Clearlooks</name>
    <cornerRadius>8</cornerRadius>
    <font place="ActiveWindow">
      <name>sans</name>
      <size>11</size>
      <slant>normal</slant>
      <weight>bold</weight>
    </font>
  </theme>

  <!-- Keyboard bindings -->
  <keyboard>
    <default />
    
    <!-- Custom keybinds similar to common window manager shortcuts -->
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    
    <!-- Application launcher -->
    <keybind key="W-space">
      <action name="Execute" command="wofi --show drun"/>
    </keybind>
    
    <!-- Terminal -->
    <keybind key="W-Return">
      <action name="Execute" command="gnome-terminal"/>
    </keybind>
    
    <!-- Screenshot with grim+slurp -->
    <keybind key="Print">
      <action name="Execute" command="grim -g &quot;$(slurp)&quot; - | swappy -f -"/>
    </keybind>
    
    <!-- Full screenshot -->
    <keybind key="S-Print">
      <action name="Execute" command="grim - | swappy -f -"/>
    </keybind>
    
    <!-- Window tiling -->
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left"/>
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right"/>
    </keybind>
    <keybind key="W-Up">
      <action name="SnapToEdge" direction="up"/>
    </keybind>
    <keybind key="W-Down">
      <action name="SnapToEdge" direction="down"/>
    </keybind>
    
  </keyboard>

  <!-- Mouse bindings -->
  <mouse>
    <default />
  </mouse>

  <!-- Window placement -->
  <placement>
    <policy>center</policy>
  </placement>

</labwc_config>
