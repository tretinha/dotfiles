#!/bin/sh
# swayidle wrapper, ported from sircmpwn's bin/idle: warn at 4m30s, lock at
# 5m, screens off at 10m. Deviations: `power` instead of the deprecated
# `dpms`, and an added before-sleep lock (this is a laptop).

lock='swaylock -f -i ~/Pictures/wallpaper.jpg --scaling fill'

exec swayidle -w \
	timeout 270 'notify-send -t 30000 "Locking screen in 30 seconds"' \
	timeout 300 "$lock" \
	timeout 600 'swaymsg "output * power off"' \
		resume 'swaymsg "output * power on"' \
	before-sleep "$lock"
