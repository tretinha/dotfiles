# Global properties
command=~/.config/i3blocks/scripts/$BLOCK_NAME
separator_block_width=15
markup=none

[spotify.py]
# command=~/.config/i3blocks/scripts/spotify.py
command=~/bin/spotify.py
interval=5

# Memory usage
[memory]
label=mem: 
interval=30

[disk]
label=/home (/dev/sda8): 
instance=/dev/sda8
interval=30
separator=false

[disk]
label=/ (/dev/sda7): 
instance=/dev/sda7
interval=30

[date-with-utc]
# command=~/.config/i3blocks/scripts/date-with-utc
command=~/bin/date-with-utc
interval=5
